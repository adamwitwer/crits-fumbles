<div class="cf-prompt">
  {{#unless lockedKind}}
  <div class="cf-kind" role="group" aria-label="{{localize "CRITSFUMBLES.RollType"}}">
    <button type="button" data-action="kind" data-kind="crit"
            class="{{#if isCrit}}active{{/if}}">{{localize "CRITSFUMBLES.CriticalHit"}}</button>
    <button type="button" data-action="kind" data-kind="fumble"
            class="{{#unless isCrit}}active{{/unless}}">{{localize "CRITSFUMBLES.Fumble"}}</button>
  </div>
  {{/unless}}

  <p class="cf-hint">
    {{#if isCrit}}{{localize "CRITSFUMBLES.ChooseDamageType"}}{{else}}{{localize "CRITSFUMBLES.ChooseCategory"}}{{/if}}
    {{#if anyDetected}}{{localize "CRITSFUMBLES.DetectedHint"}}{{/if}}
  </p>

  {{#each groups}}
  <section class="cf-group">
    {{#if this.label}}<h4>{{this.label}}</h4>{{/if}}
    <div class="cf-types">
      {{#each this.types}}
      <button type="button" data-action="pick" data-type="{{this.type}}"
              class="cf-type-button {{#if this.detected}}cf-detected{{/if}}">{{this.label}}</button>
      {{/each}}
    </div>
  </section>
  {{/each}}
</div>
